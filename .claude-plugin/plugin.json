{
  "name": "caption-checker",
  "version": "1.2.0",
  "description": "MCP server that checks SRT and WebVTT captions against Netflix English, the BBC subtitle guidelines and the DCMP Captioning Key: reading speed, characters a line, lines, time on screen, gaps and overlaps.",
  "author": {
    "name": "Mark Studios",
    "url": "https://www.markstudios.com"
  },
  "homepage": "https://www.markstudios.com/tools/caption-checker",
  "repository": "https://github.com/markksantos/caption-checker",
  "license": "MIT",
  "keywords": [
    "mcp",
    "captions",
    "subtitles",
    "srt",
    "webvtt",
    "accessibility",
    "netflix",
    "bbc",
    "dcmp",
    "reading-speed"
  ],
  "mcpServers": {
    "caption-checker": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/caption-check.js",
        "--mcp"
      ]
    }
  }
}
